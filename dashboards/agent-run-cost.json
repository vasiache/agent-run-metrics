{
  "title": "Agent run cost",
  "uid": "agent-run-cost",
  "schemaVersion": 39,
  "version": 8,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "runtime",
        "label": "Runtime",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_tokens_total, runtime)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "user",
        "label": "User",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_tokens_total, user)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_tokens_total, project)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "tool",
        "label": "Tool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_tool_calls_total, tool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "skill",
        "label": "Skill",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_skill_calls_total, skill)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "plugin",
        "label": "Plugin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_plugin_calls_total, plugin)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(agent_tokens_total, session)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tokens total",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(agent_tokens_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\"}[$__interval])",
          "refId": "A"
        }
      ],
      "description": "Sum of all tokens (input, output, cache reads and writes) across the selected sessions, cumulative since each session started. Usually dominated by cache_read, which is normal: every turn re-reads the prompt from cache. Use it for volume, not cost."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost total",
      "description": "Money spent per the report analyzers (session_timeline.py / run_timeline.py with --push-gateway). OpenCode reports carry cost directly; Claude Code transcripts have no prices yet, so this stat only moves when OpenCode sessions are analyzed. Reset the time range to see what a period cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(agent_session_cost_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\"}[$__interval])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Context window max",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(agent_context_max_tokens{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\"}[$__interval])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "The largest prompt+cache context any selected session reached. Watch it against the model's context limit: when it approaches the limit, the session is close to auto-compaction and loses older detail. A value that keeps growing across one session is normal; a value that jumps back down means a new session or a compaction."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tool calls total",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(agent_tool_calls_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\",tool=~\"$tool\"}[$__interval])",
          "refId": "A"
        }
      ],
      "description": "Number of tool executions across the selected sessions. Filter by the Tool variable to see one tool. A high count with flat token spend usually means cheap mechanical work; a high count with exploding tokens means each call carries a big payload (large reads, long outputs)."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (runtime, kind) (rate(agent_tokens_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\"}[15m]))",
          "legendFormat": "{{runtime}} · {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Token burn rate per kind over the last 15 minutes, per runtime. This is the live pulse: input and cache_read spikes mean big prompts being sent right now, output spikes mean the model is writing a lot. Flat lines mean idle or stale sessions still counted in the totals above."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top tool calls",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "increase(topk(5, agent_tool_calls_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\",tool=~\"$tool\"}))",
          "legendFormat": "{{runtime}} · {{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Growth of the five most-used tools over the selected range (increase of the per-session cumulative counters). Compare shapes between runtimes: a coding session is Edit-heavy, research is WebSearch/Read-heavy. Click a legend entry to isolate one series; use the Tool variable to exclude noise like Bash wrappers."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gate feedback (seconds)",
      "description": "Seconds between a source edit and the gate feedback that caught a problem in the same area (from run_timeline.py --gate-regex with a --watch pattern). Short is good: the agent still holds the edit context and fixes it cheaply. Past ~30 minutes the context is gone, which is what the AgentDefectFeedbackSlow alert fires on. Empty when no gate analysis was pushed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "agent_edit_to_gate_seconds{project=~\"$project\"}",
          "legendFormat": "{{session}} {{gate}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Top skills call",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "increase(topk(5, agent_skill_calls_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\",skill=~\"$skill\"}[$__interval]))",
          "legendFormat": "{{runtime}} · {{skill}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Five most-invoked skills (the Skill tool in Claude Code transcripts), cumulative per session. Use it to see which workflows the agent actually runs versus which ones exist. Select a skill in the Skill variable to track its usage over time."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Top Plugins call",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "increase(topk(5, agent_plugin_calls_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\",plugin=~\"$plugin\"}[$__interval]))",
          "legendFormat": "{{runtime}} · {{plugin}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Five most-invoked plugins, derived from the plugin:skill naming in skill calls. This is where the metrics integration itself shows up too, so a nonzero baseline here is self-monitoring, not a leak. Use it to spot plugins that cost tokens but never earn their keep."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Active sessions (5 min)",
      "description": "Session groups that pushed within the last 5 minutes: parallel sessions on this host, counted separately. A number that stays high while you are not working means a hook is still pushing somewhere (a stuck process or another machine with the same instance label).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "count(push_time_seconds{} > (time() - 300))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sessions over period (main vs subagents)",
      "description": "Token spend per session over the selected period. Subagent runs carry the parent session label, so each session's total already includes its subagents (separate series).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "main {{session}}",
          "expr": "sum by (session) (increase(agent_tokens_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\",session=~\"$session\"}[$__interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "sub {{session}}",
          "expr": "sum by (session) (increase(agent_subagent_tokens_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\",session=~\"$session\"}[$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Subagent tokens by agent",
      "description": "Token spend of subagent runs grouped by agent type (Explore, Plan, ...). Aggregated per agent name in the hook, so parallel runs of one type merge into one series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{agent}}",
          "expr": "sum by (agent) (increase(agent_subagent_tokens_total{runtime=~\"$runtime\",user=~\"$user\",project=~\"$project\"}[$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}