{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/agent-metrics/push-metrics.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/agent-metrics/push-metrics.mjs" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/hooks/agent-metrics/push-metrics.mjs" }
        ]
      }
    ]
  }
}
