{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {{plugin_dir}}/claude-code/push-metrics.mjs",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {{plugin_dir}}/claude-code/push-metrics.mjs",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {{plugin_dir}}/claude-code/push-metrics.mjs",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
